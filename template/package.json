{
  "name": "app",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "concurrently": "10.0.6",
    "vite": "8.3.5"
  }
}
