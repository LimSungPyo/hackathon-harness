# 프로젝트 환경 변수는 이 파일 하나로 관리한다. `cp .env.example .env` 후 필요한 값만 바꾼다.
# 모두 기본값이 있어 .env 없이도 뜬다.

# ── docker compose 호스트 포트 ───────────────────────
FRONTEND_PORT=5173
BACKEND_PORT=8000
DB_PORT=5432

# ── DB (docker compose --profile db 일 때만) ─────────
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${DB_PORT}/app

# ── backend ────────────────────────────────────────
# 추가로 허용할 CORS 출처. 쉼표로 구분하고, localhost:5173은 기본 허용이다.
CORS_ORIGINS=

# ── frontend ───────────────────────────────────────
# 로컬 Vite 개발 서버가 /api 요청을 넘길 주소. Docker에서는 compose가 http://backend:8000으로 넘긴다.
VITE_API_PROXY=http://localhost:8000
CHOKIDAR_USEPOLLING=false
